{
  "name": "embedded-framework-knowledge-base-site",
  "version": "1.0.0",
  "private": true,
  "description": "Embedded platform, framework, architecture and project template knowledge base powered by docmd.",
  "scripts": {
    "check:site": "node scripts/check-site.mjs",
    "dev": "npm run check:site && npx --yes @docmd/core@0.9.8 dev",
    "validate": "npm run check:site && npx --yes @docmd/core@0.9.8 validate --json",
    "build": "npm run check:site && npx --yes @docmd/core@0.9.8 build",
    "doctor": "npx --yes @docmd/core@0.9.8 doctor"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
